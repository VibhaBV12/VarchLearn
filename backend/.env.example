# Server Configuration
PORT=4000
NODE_ENV=development

# PostgreSQL Database URL (Update username, password, host, port, and database name)
DATABASE_URL="postgresql://postgres:gurunatha@localhost:5432/varchlearn_db?schema=public"

# JWT Secrets (Change to strong random strings in production)
JWT_SECRET="replace-with-a-strong-random-jwt-secret"
JWT_EXPIRES_IN="7d"

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://localhost:8081,http://localhost:19006"

# Groq AI Configuration (Required for PDF-grounded AI generation)
AI_PROVIDER="groq"
GROQ_API_KEY="YOUR_GROQ_API_KEY"
GROQ_MODEL="llama-3.3-70b-versatile"

# File Uploads
UPLOAD_DIR="./uploads"
MAX_PDF_SIZE_MB=20
