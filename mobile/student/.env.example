# Backend API Configuration
# IMPORTANT: For physical Android phones using Expo Go, replace localhost with your Windows PC's local Wi-Fi IPv4 address (e.g. http://192.168.1.42:4000/api/v1)
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1

# Integrated Backend Mode is enabled by default (false = real PostgreSQL backend, true = offline mock mode)
EXPO_PUBLIC_USE_MOCK_API=false
